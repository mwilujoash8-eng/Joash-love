{
  "entities": {
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "A payment submission by a parent or school waiting for platform admin approval",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique request identifier",
          "maxLength": 128
        },
        "targetType": {
          "type": "string",
          "enum": ["school", "parent"],
          "description": "Whether the subscription is for a school or parent account"
        },
        "targetId": {
          "type": "string",
          "description": "Identifier of the school or parent user",
          "maxLength": 128
        },
        "targetName": {
          "type": "string",
          "description": "Name of school or parent",
          "maxLength": 200
        },
        "requesterId": {
          "type": "string",
          "description": "User ID of requester",
          "maxLength": 128
        },
        "requesterName": {
          "type": "string",
          "description": "Full name of the person submitting payment",
          "maxLength": 200
        },
        "requesterContact": {
          "type": "string",
          "description": "Phone number or email of requester",
          "maxLength": 100
        },
        "requesterEmail": {
          "type": "string",
          "description": "Email address of requester",
          "maxLength": 150
        },
        "requesterPhone": {
          "type": "string",
          "description": "Phone number of requester",
          "maxLength": 50
        },
        "requestedTier": {
          "type": "string",
          "enum": ["medium", "premium"],
          "description": "Subscription tier requested"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["monthly", "annually"],
          "description": "Billing cadence"
        },
        "priceZMW": {
          "type": "number",
          "description": "Amount in Zambian Kwacha"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["airtel_money", "mtn_momo", "zamtel_kwacha", "bank_transfer", "activation_key"],
          "description": "Payment channel used"
        },
        "paymentReference": {
          "type": "string",
          "description": "Mobile money transaction ID or reference code",
          "maxLength": 100
        },
        "requestDate": {
          "type": "string",
          "description": "Date of request submission",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["pending_review", "approved", "rejected"],
          "description": "Approval review state"
        },
        "reviewedAt": {
          "type": "string",
          "description": "Timestamp when admin confirmed or rejected",
          "maxLength": 50
        },
        "reviewedBy": {
          "type": "string",
          "description": "Admin email who performed review",
          "maxLength": 150
        },
        "reviewNotes": {
          "type": "string",
          "description": "Admin comments or rejection reason",
          "maxLength": 500
        }
      },
      "required": ["id", "targetType", "targetId", "targetName", "requesterName", "requestedTier", "priceZMW", "paymentMethod", "paymentReference", "requestDate", "status"]
    },
    "ActivationKey": {
      "title": "ActivationKey",
      "description": "Single-use digital voucher generated by admin to unlock medium/premium plans",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique key record identifier",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "description": "Alpha-numeric voucher code",
          "maxLength": 64
        },
        "targetType": {
          "type": "string",
          "enum": ["school", "parent"],
          "description": "Target entity category"
        },
        "targetId": {
          "type": "string",
          "description": "Assigned school or parent ID",
          "maxLength": 128
        },
        "targetName": {
          "type": "string",
          "description": "School or parent name",
          "maxLength": 200
        },
        "tier": {
          "type": "string",
          "enum": ["medium", "premium"],
          "description": "Tier unlocked by key"
        },
        "priceZMW": {
          "type": "number",
          "description": "Kwacha value of key"
        },
        "status": {
          "type": "string",
          "enum": ["active_unused", "redeemed", "revoked"],
          "description": "Current lifecycle status"
        },
        "generatedBy": {
          "type": "string",
          "description": "Admin email who created key",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        },
        "redeemedAt": {
          "type": "string",
          "description": "Redemption timestamp",
          "maxLength": 50
        },
        "redeemedBy": {
          "type": "string",
          "description": "User who redeemed voucher",
          "maxLength": 150
        }
      },
      "required": ["id", "code", "targetType", "targetId", "targetName", "tier", "priceZMW", "status", "generatedBy", "createdAt"]
    },
    "GoogleMeetSpace": {
      "title": "GoogleMeetSpace",
      "description": "Google Meet video conference session created for classes, PTA meetings, or staff briefings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique meeting identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Topic or title of the meeting",
          "maxLength": 200
        },
        "meetUri": {
          "type": "string",
          "description": "Direct Google Meet URL",
          "maxLength": 300
        },
        "meetingCode": {
          "type": "string",
          "description": "Google Meet code e.g. xxx-yyyy-zzz",
          "maxLength": 50
        },
        "hostName": {
          "type": "string",
          "description": "Host full name",
          "maxLength": 200
        },
        "hostEmail": {
          "type": "string",
          "description": "Host email",
          "maxLength": 150
        },
        "schoolId": {
          "type": "string",
          "description": "Associated school ID",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": ["class_tutorial", "pta_meeting", "staff_briefing", "ecz_prep", "consultation"],
          "description": "Category of meeting"
        },
        "scheduledTime": {
          "type": "string",
          "description": "ISO date-time or time string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation",
          "maxLength": 50
        }
      },
      "required": ["id", "title", "meetUri", "meetingCode", "hostEmail", "createdAt"]
    }
  },
  "firestore": {
    "/subscriptionRequests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Pending, approved, and rejected subscription payment requests submitted by parents and schools"
    },
    "/activationKeys/{keyId}": {
      "schema": "ActivationKey",
      "description": "Platform administrator generated digital activation vouchers"
    },
    "/meetSpaces/{spaceId}": {
      "schema": "GoogleMeetSpace",
      "description": "Google Meet video conferencing spaces and classroom tutorials"
    }
  }
}
